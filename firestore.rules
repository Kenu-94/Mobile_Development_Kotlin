rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profiel: iedereen die ingelogd is mag lezen, enkel je eigen profiel wijzigen.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Winkel: document-id = uid van de handelaar.
    match /stores/{storeId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == storeId
                            && request.resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null && request.auth.uid == storeId;
    }

    // Pakketten: handelaar beheert zijn eigen pakketten; een klant mag enkel quantityLeft wijzigen (reserveren/annuleren).
    match /bags/{bagId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.storeId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.storeId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantityLeft'])
      );
      allow delete: if request.auth != null && resource.data.storeId == request.auth.uid;
    }

    // Reservaties: klant maakt aan en annuleert; handelaar markeert als opgehaald.
    match /reservations/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.customerId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.storeId == request.auth.uid ||
        (resource.data.customerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
      );
    }
  }
}
